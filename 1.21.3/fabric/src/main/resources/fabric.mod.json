{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://github.com/Stein-N/Resource-Library",
        "sources": "https://github.com/Stein-N/Resource-Library",
        "issues": "https://github.com/Stein-N/Resource-Library/issues"
    },
    "license": "${mod_license}",
    "icon": "icon_fabric.png",
    "environment": "*",
    "entrypoints": {
        "main": [ "net.xstopho.resourcelibrary.ResourceLibrary" ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabric-api": "*",
        "fabricloader": "*",
        "minecraft": ">=1.21.2 <1.21.4",
        "java": ">=21"
    },
    "custom": {
        "modmenu": {
            "badges": ["library"],
            "update-checker": true
        }
    }
}